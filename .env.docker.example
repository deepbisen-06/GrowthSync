# Generate two different hex values. Do not commit .env.docker.
POSTGRES_PASSWORD=replace_with_random_hex_password
SECRET_KEY=replace_with_a_different_random_hex_secret
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Local Docker check (creates a SEPARATE PostgreSQL database)
ENVIRONMENT=development
FRONTEND_URL=http://localhost:8080
SITE_ADDRESS=:80
WEB_HTTP_PORT=8080
WEB_HTTPS_PORT=8443
# Public HTTPS: use ENVIRONMENT=production, FRONTEND_URL=https://your-domain,
# SITE_ADDRESS=your-domain, WEB_HTTP_PORT=80 and WEB_HTTPS_PORT=443.

